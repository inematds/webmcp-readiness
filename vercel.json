{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/readiness.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "tools=(self), camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Origin-Agent-Cluster",
          "value": "?1"
        }
      ]
    }
  ]
}
